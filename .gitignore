############################################
# Python
############################################
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.build/
dist/
.cache/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

############################################
# Node / Frontend (Vite / React)
############################################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.vite/
dist/

############################################
# Local data / generated artifacts
############################################
backend/data/
backend/**/*.json

# Allow example/sample data if you ever add it
!backend/data/.gitkeep

# Generated/cloned RAG doc mirrors — rebuilt on deploy by
# app.tools.bootstrap_rag_sources (clones AVM/CAF repos and exports docs).
# Only the small curated *_urls.txt / *-resource-types.txt inputs are tracked.
backend/agent/rag/avm/
backend/agent/rag/caf/
backend/agent/rag/terraform/docs/
backend/agent/rag/terraform/source-repos/

############################################
# Azure / Auth / Secrets
############################################
.env
.env.*
!.env.sample
*.pem
*.key
*.crt
*.pfx
*.cer

############################################
# VS Code (keep useful settings)
############################################
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

############################################
# OS / Editor noise
############################################
.DS_Store
Thumbs.db
desktop.ini

############################################
# Logs
############################################
*.log

############################################
# Coverage / reports
############################################
coverage/
htmlcov/

############################################
# Temporary files
############################################
*.tmp
*.swp
*.swo

ai-context/
.*:Zone.Identifier

############################################
# Terraform files
############################################
.terraform/
.terraform.*
!.terraform.sample
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.*
!*.tfvars.example
tfplan
