project_name        = "resilienceiq"
environment         = "dev"
location            = "eastus"
resource_group_name = "resilience-iq"

search_sku = "basic"
vm_size = "Standard_B2als_v2"
# Optional: target a specific availability zone when SKU capacity is constrained
# vm_zone = "1"

# Optional: override Foundry model deployments used by backend and ingestion
