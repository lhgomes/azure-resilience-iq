# reasoning_model_version         = "2025-04-14"
# reasoning_model_sku             = "GlobalStandard"
# reasoning_model_capacity        = 200
# embedding_model_deployment_name = "text-embedding-3-small"
# embedding_model_name            = "text-embedding-3-small"
# embedding_model_version         = "1"
# embedding_model_sku             = "GlobalStandard"
# embedding_model_capacity        = 200

tags = {
  owner  = "platform"
  system = "azure-resilience-iq"
}
