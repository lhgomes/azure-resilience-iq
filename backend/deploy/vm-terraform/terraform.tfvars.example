project_name        = "resilienceiq"
environment         = "dev"
location            = "eastus"
resource_group_name = "resilience-iq"

search_sku = "basic"
vm_size   = "Standard_D4s_v5"
# Optional: target a specific availability zone when SKU capacity is constrained
# vm_zone = "1"

# Azure Bastion Standard is enabled by default for automatic package transfer
# and RDP access. Use --disable-bastion to opt out when running the deploy script.
# A direct Terraform invocation can set enable_bastion = false instead.

# The Windows VM has no public IP. Without Bastion, interactive access requires
# an existing private network path to the VNet. Storage remains private in both
# modes. Bastion and its public IP incur charges while deployed.

# Entra ID (AD Integrated) RDP sign-in is granted to the deploy principal by
# default. When the person connecting differs from whoever ran `az login`
# (for example CI or service-principal deployments), list their Entra user or
# group object ids here so they can sign in; the local admin account is only an
# emergency fallback.
# entra_login_object_ids = ["00000000-0000-0000-0000-000000000000"]

# Optional: override Foundry model deployments used by backend and ingestion
# reasoning_model_deployment_name = "gpt-5.4-mini"
# reasoning_model_name            = "gpt-5.4-mini"
# reasoning_model_version         = "2026-03-17"
# reasoning_model_sku             = "GlobalStandard"
# reasoning_model_capacity        = 100
# embedding_model_deployment_name = "text-embedding-3-small"
# embedding_model_name            = "text-embedding-3-small"
# embedding_model_version         = "1"
# embedding_model_sku             = "GlobalStandard"
# embedding_model_capacity        = 200

tags = {
  owner  = "platform"
  system = "azure-resilience-iq"
}
